rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection holds password hashes - no client (browser) access at all.
    // Login/registration now go through server-side API routes using the
    // Firebase Admin SDK, which bypasses these rules entirely.
    match /users/{userId} {
      allow read, write: if false;
    }

    // Everything else (topics, quiz_completions, ...) keeps its current
    // fully-open behavior for now - unchanged from before this fix.
    // NOTE: each collection is listed explicitly instead of a catch-all
    // {document=**} match, because Firestore combines overlapping match
    // blocks with OR - a catch-all would re-open the users collection above.
    match /topics/{topicId} {
      allow read, write: if true;
    }
    match /quiz_completions/{docId} {
      allow read, write: if true;
    }
  }
}
